# ─── AI ────────────────────────────────────────────────────────────────────────
# OpenRouter API key — required. Used for cover letter tailoring, question
# answering, and error analysis. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# ─── SEEK ──────────────────────────────────────────────────────────────────────
SEEK_EMAIL=you@example.com

# Base64-encoded slim Playwright storage state for seek.com.au.
# In CI this is loaded from the SEEK_SESSION_COOKIES GitHub secret and the
# bot refreshes it on every successful run (see saveSession in lib/seek-session.ts).
# Leave blank locally to use the on-disk session at data/sessions/seek-session.json.
SEEK_SESSION_COOKIES=

# ─── INDEED (Phase 2 — not used yet) ───────────────────────────────────────────
INDEED_EMAIL=
INDEED_PASSWORD=

# ─── GLASSDOOR (Phase 2 — not used yet) ────────────────────────────────────────
GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=

# ─── RUN LIMITS ────────────────────────────────────────────────────────────────
MAX_APPS_PER_RUN=20
MAX_APPS_PER_SEARCH=10

# ─── FEATURE FLAGS ─────────────────────────────────────────────────────────────
RESUME_TAILORING_ENABLED=true
AUTO_SUBMIT_ENABLED=true
DRY_RUN=false

# debug | info | warn | error
LOG_LEVEL=info
